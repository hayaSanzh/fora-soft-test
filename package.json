{
  "name": "video-chat-room",
  "version": "0.1.0",
  "private": true,
  "description": "Групповой видеочат до 4 участников: WebRTC mesh + Socket.io сигналинг и чат",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0 <21"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "predev": "npm run build --workspace shared",
    "dev": "concurrently --names server,client --prefix-colors cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace client && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "pretypecheck": "npm run build --workspace shared",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build --workspace shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rm -rf shared/dist server/dist client/dist coverage",
    "serve": "npm run build && npm start"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7"
  }
}

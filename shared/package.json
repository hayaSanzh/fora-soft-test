{
  "name": "@video-chat/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Единый контракт клиента и сервера: типы событий, схемы валидации, константы",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
